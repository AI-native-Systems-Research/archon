digraph archon {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fillcolor="#eef3fb", color="#4a6fa5"];
  edge [fontname="Helvetica", fontsize=10];
  "env:HF_TOKEN" [shape=note, fillcolor="#fdf0d5", color="#c9820a"];
  "flag:update-golden" [shape=note, fillcolor="#fdf0d5", color="#c9820a"];
  "inference-sim";
  "cmd";
  "sim";
  "cluster";
  "hash";
  "testutil";
  "tokenid";
  "util";
  "kv";
  "latency";
  "lora";
  "saturation";
  "trace";
  "workload";
  "inference-sim" -> "cmd" [color="#333333"];
  "cmd" -> "env:HF_TOKEN" [style=dotted, arrowhead=vee, color="#c9820a", label="config"];
  "cmd" -> "sim" [color="#333333"];
  "cmd" -> "cluster" [color="#333333"];
  "cmd" -> "latency" [color="#333333"];
  "cmd" -> "lora" [color="#bbbbbb"];
  "cmd" -> "saturation" [color="#333333"];
  "cmd" -> "trace" [color="#333333"];
  "cmd" -> "workload" [color="#333333"];
  "sim" -> "hash" [color="#333333"];
  "sim" -> "tokenid" [color="#bbbbbb"];
  "sim" -> "util" [color="#333333"];
  "cluster" -> "sim" [color="#333333"];
  "cluster" -> "sim" [style=dashed, arrowhead=onormal, color="#8a5cf6", label="implements"];
  "cluster" -> "kv" [color="#333333"];
  "cluster" -> "latency" [color="#333333"];
  "cluster" -> "trace" [color="#333333"];
  "cluster" -> "workload" [color="#bbbbbb"];
  "hash" -> "tokenid" [color="#bbbbbb"];
  "testutil" -> "flag:update-golden" [style=dotted, arrowhead=vee, color="#c9820a", label="config"];
  "kv" -> "sim" [color="#333333"];
  "kv" -> "sim" [style=dashed, arrowhead=onormal, color="#8a5cf6", label="implements"];
  "kv" -> "hash" [color="#333333"];
  "kv" -> "util" [color="#333333"];
  "latency" -> "sim" [color="#333333"];
  "latency" -> "sim" [style=dashed, arrowhead=onormal, color="#8a5cf6", label="implements"];
  "lora" -> "sim" [style=dashed, arrowhead=onormal, color="#8a5cf6", label="implements"];
  "lora" -> "sim" [color="#bbbbbb"];
  "saturation" -> "sim" [style=dashed, arrowhead=onormal, color="#8a5cf6", label="implements"];
  "saturation" -> "sim" [color="#bbbbbb"];
  "saturation" -> "workload" [color="#333333"];
  "workload" -> "sim" [color="#333333"];
}
